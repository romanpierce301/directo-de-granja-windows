{
  "appId": "com.directodegranja.windows",
  "productName": "Directo de Granja",
  "copyright": "Directo de Granja",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "electron/icon.png",
    "package.json",
    "!node_modules/.cache/**"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "node_modules/better-sqlite3/**"
  ],
  "win": {
    "icon": "electron/icon.png",
    "verifyUpdateCodeSignature": false,
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "DirectoDeGranja-Windows-Portable.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "DirectoDeGranja-Instalador-Windows.exe"
  }
}
