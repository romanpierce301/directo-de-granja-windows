{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "sync-route": {
        "ClusterId": "sync-cluster",
        "Match": { "Path": "/api/sync/{**catch-all}" }
      },
      "ledger-route": {
        "ClusterId": "ledger-cluster",
        "Match": { "Path": "/api/ledger/{**catch-all}" }
      },
      "monitoring-route": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/monitoring/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": { "Destinations": { "d1": { "Address": "http://auth-service:8080" } } },
      "sync-cluster": { "Destinations": { "d1": { "Address": "http://sync-service:8080" } } },
      "ledger-cluster": { "Destinations": { "d1": { "Address": "http://ledger-service:8080" } } },
      "monitoring-cluster": { "Destinations": { "d1": { "Address": "http://monitoring-service:8080" } } }
    }
  }
}
