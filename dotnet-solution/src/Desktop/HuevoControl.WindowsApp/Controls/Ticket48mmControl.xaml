<UserControl x:Class="HuevoControl.WindowsApp.Controls.Ticket48mmControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="181.4" Background="#FFFFFF">
    <!-- Ancho exacto de 48mm a 96 DPI (48 / 25.4 * 96 = 181.42 DIP) idéntico a la plantilla PNG/PDF -->
    <StackPanel Margin="6,8,6,8" TextElement.Foreground="#000000" TextElement.FontFamily="Consolas">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52*"/>
                <ColumnDefinition Width="48*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Assets/logo_directo_de_granja.png" Stretch="Uniform" MaxHeight="90"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="DIRECTO" FontFamily="Segoe UI" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                <TextBlock Text="DE" FontFamily="Segoe UI" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                <TextBlock Text="GRANJA" FontFamily="Segoe UI" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Te faltan huevos" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        <TextBlock Text="a nosotros nos sobran" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>

        <TextBlock x:Name="TxtPhone" Text="Tel. 000 000 0000" FontSize="8.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        <TextBlock x:Name="TxtAddress" Text="Dirección del negocio" FontSize="8.5" HorizontalAlignment="Center" TextWrapping="Wrap"/>

        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Margin="0,6,0,6"/>

        <Grid>
            <TextBlock x:Name="TxtFolio" Text="Folio: A-0001" FontSize="8.5" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtDate" Text="15/11/2026" FontSize="8.5" HorizontalAlignment="Right"/>
        </Grid>
        <TextBlock x:Name="TxtTime" Text="10:42" FontSize="8.5" HorizontalAlignment="Right"/>

        <TextBlock Text="Cliente:" FontSize="8.5" Margin="0,4,0,0"/>
        <TextBlock x:Name="TxtCustomer" Text="Abarrotes López" FontSize="8.5" TextWrapping="Wrap"/>

        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Margin="0,6,0,6"/>

        <ItemsControl x:Name="BoxesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <TextBlock Text="{Binding Label}" FontSize="8.5" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Weight}" FontSize="8.5" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Margin="0,6,0,6"/>

        <Grid>
            <TextBlock Text="Kilos totales" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtTotalKg" Text="120.60 kg" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,2,0,0">
            <TextBlock Text="Precio por kilo" FontSize="8.5" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtPriceKg" Text="$37.00" FontSize="8.5" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,2,0,0">
            <TextBlock Text="TOTAL A COBRAR" FontWeight="Bold" FontSize="9" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtTotalCharge" Text="$4,462" FontWeight="Bold" FontSize="9" HorizontalAlignment="Right"/>
        </Grid>

        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Margin="0,6,0,6"/>

        <Grid>
            <TextBlock x:Name="TxtPaidLabel" Text="Pagado (efectivo)" FontSize="8.5" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtPaidAmount" Text="$800" FontSize="8.5" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,2,0,0">
            <TextBlock Text="Saldo de esta entrega" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtDeliveryBalance" Text="$3,662" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,2,0,0">
            <TextBlock Text="Saldo total del cliente" FontSize="8.5" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtCustomerBalance" Text="$3,662" FontSize="8.5" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Comprobante de entrega," FontSize="8.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="no es factura" FontSize="8.5" HorizontalAlignment="Center"/>
        <TextBlock Text="Firma de recibido:" FontSize="8.5" Margin="0,10,0,28"/>

        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Margin="0,0,0,6"/>
        <TextBlock Text="¡Gracias por su compra!" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
