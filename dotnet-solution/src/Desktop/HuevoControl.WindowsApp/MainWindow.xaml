<Window x:Class="HuevoControl.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HuevoControl.WindowsApp.Controls"
        Title="HuevoControl — Directo de Granja (Dueño Windows)"
        Height="840" Width="1360" MinHeight="720" MinWidth="1024"
        Background="#0A0D14" Foreground="#E1E2EC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral azul marino -->
        <Border Grid.Column="0" Background="#0F3D7A" Padding="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Border Width="54" Height="36" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Gemini_Generated_Image_13e89c53.jpeg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DIRECTO DE GRANJA" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                        <TextBlock Text="Consola Dueño (.NET 8)" FontSize="11" Foreground="#71FFE5"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="Panel y SQL Server" Style="{StaticResource Tactile3DPrimaryButton}" Margin="0,0,0,8" Click="OnSyncSqlClick"/>
                <Button Content="Exportar Excel Seguro" Style="{StaticResource Tactile3DEmeraldButton}" Margin="0,0,0,8" Click="OnExportExcelClick"/>
                <Button Content="Imprimir Ticket 48mm" Style="{StaticResource Tactile3DPrimaryButton}" Margin="0,0,0,8" Click="OnPrintTicketClick"/>
            </StackPanel>
        </Border>

        <!-- Área Principal con Ticket 48mm Integrado -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Integración SQL Server Local y Sincronización Tiempo Real" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock x:Name="TxtConnectionStatus" Text="Listo para conectar con SQL Server local y SignalR" FontSize="12" Foreground="#71FFE5" Margin="0,4,0,16"/>

                <Border Background="#141C2B" CornerRadius="8" Padding="16" BorderBrush="#26334D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Última entrega sincronizada" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="Sin entregas sincronizadas aún. Conecte SQL Server local o la app Android para recibir entregas reales."
                                   FontFamily="Consolas" FontSize="12" Foreground="#E1E2EC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="#141C2B" CornerRadius="8" Padding="14" BorderBrush="#26334D" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Vista previa Ticket 48mm" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <controls:Ticket48mmControl x:Name="TicketPreview"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
